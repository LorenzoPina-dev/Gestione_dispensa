{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.gestione-dispensa.local/events/inventory.stock.consumed.v1.json",
  "title": "Inventory stock consumed v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["stockItemId", "productId", "quantity", "unit", "consumptionSource", "confidence"],
  "properties": {
    "stockItemId": { "type": "string", "format": "uuid" },
    "productId": { "type": "string", "format": "uuid" },
    "quantity": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
    "unit": { "type": "string", "enum": ["g", "kg", "ml", "l", "piece", "pack"] },
    "consumptionSource": { "type": "string", "enum": ["MANUAL", "RECIPE", "DIARY", "IMPORT"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
