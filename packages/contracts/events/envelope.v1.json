{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.gestione-dispensa.local/events/envelope.v1.json",
  "title": "Event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId","eventType","schemaVersion","occurredAt","producer","aggregateId","familyId","correlationId","causationId","payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "minLength": 1 },
    "aggregateId": { "type": "string", "minLength": 1 },
    "familyId": { "type": ["string", "null"] },
    "correlationId": { "type": "string", "minLength": 1 },
    "causationId": { "type": ["string", "null"] },
    "payload": { "type": "object" }
  }
}
