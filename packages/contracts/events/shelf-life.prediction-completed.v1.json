{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.gestione-dispensa.local/events/shelf-life.prediction-completed.v1.json",
  "title": "Shelf-Life prediction completed v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "predictionId",
    "itemId",
    "productId",
    "estimatedExpiresAt",
    "confidence",
    "modelVersion"
  ],
  "properties": {
    "predictionId": {
      "type": "string",
      "format": "uuid"
    },
    "itemId": {
      "type": "string",
      "format": "uuid"
    },
    "productId": {
      "type": "string",
      "format": "uuid"
    },
    "estimatedExpiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "modelVersion": {
      "type": "string"
    }
  }
}
