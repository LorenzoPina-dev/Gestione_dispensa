# Browser-facing URLs must stay relative in the local HTTPS profile.
# The browser talks only to nginx on https://192.168.1.24:8443.
VITE_API_BASE_URL=/api/v1
VITE_OIDC_ISSUER=/realms/dispensa
VITE_OIDC_CLIENT_ID=dispensa-app

# Optional fallback family id, used only before a user logs in / before Onboarding creates a
# real family. Normally not needed.
# VITE_FAMILY_ID=

# Optional bearer token for API-layer testing. Never commit a real token.
# VITE_DEV_BEARER_TOKEN=
