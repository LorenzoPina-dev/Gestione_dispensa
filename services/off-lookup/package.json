{
  "name": "@gestione-dispensa/off-lookup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone read-through lookup service for Open Food Facts barcodes: local MongoDB dump first, live OFF API v3 fallback, auto-heals the local cache.",
  "dependencies": {
    "express": "^4.21.2",
    "mongodb": "^6.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "test:unit": "node --import tsx --test test/unit.test.ts test/http-client.test.ts",
    "test:http": "node --import tsx --test test/http.test.ts",
    "test:integration": "node --import tsx --test test/integration.test.ts",
    "test:integration:images": "node --import tsx --test test/mongo-image-api-http.integration.test.ts"
  }
}
