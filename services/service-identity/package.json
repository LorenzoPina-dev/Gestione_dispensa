{
  "name": "@gestione-dispensa/service-identity",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test test/register.test.ts test/dietary-preferences.test.ts",
    "test:http": "node --import tsx --test test/http.test.ts",
    "test:migration": "npm run build && node --import tsx --test test/migration.test.ts"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "@gestione-dispensa/runtime-db": "2.0.0",
    "@gestione-dispensa/food-rules": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
