{
  "name": "@gestione-dispensa/service-nutrition",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test test/unit.test.ts test/catalog-client.test.ts",
    "test:http": "node --import tsx --test test/http.test.ts",
    "test:migration": "npm run build && node --import tsx --test test/migration.test.ts",
    "test:integration": "node --import tsx --test test/integration.test.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "redis": "^6.3.0",
    "@gestione-dispensa/runtime-db": "2.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
