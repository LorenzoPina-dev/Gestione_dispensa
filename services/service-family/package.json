{
  "name": "@gestione-dispensa/service-family",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:http": "node --import tsx --test test/http.test.ts",
    "test:integration": "node --import tsx --test test/integration.test.ts",
    "test:migration": "node --import tsx --test test/migration.test.ts",
    "test:unit": "node --import tsx --test test/unit.test.ts"
  },
  "dependencies": {
    "@gestione-dispensa/runtime-db": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
