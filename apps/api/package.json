{
  "name": "@gestione-dispensa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@gestione-dispensa/observability": "0.1.0",
    "express": "^4.21.2",
    "jose": "^6.1.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.10",
    "tsx": "^4.23.15"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "test": "npm run build && node --experimental-strip-types --test tests/*.mjs",
    "test:integration": "node --experimental-strip-types --test tests/postgres-client.integration.test.mjs"
  }
}
