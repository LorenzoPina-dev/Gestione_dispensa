# Base URL of the Dispensa API used by the web app.
# Matches API_PORT from the repo root .env.example (docker-compose --profile family-local)
# plus the /api/v1 base path.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Optional fallback family id, used only before a user logs in / before Onboarding creates a
# real family. Normally not needed — Onboarding's "create a family" step calls the real
# POST /api/v1/families and the app uses the id it gets back automatically.
# VITE_FAMILY_ID=

# Optional OIDC bearer token for local testing against a real backend. Login/Register in this UI
# are mock screens (no password-auth endpoint exists server-side) — this lets you test the API
# layer without a real login flow. Never commit a real token.
# VITE_DEV_BEARER_TOKEN=
