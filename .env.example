APP_ENV=family-local
LAN_HOST=192.168.1.24
APP_VERSION=0.1.0-local
API_PORT=3000
POSTGRES_DB=dispensa
POSTGRES_USER=dispensa
POSTGRES_PASSWORD=change-me-local-only
REDIS_PORT=6379
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-only
KEYCLOAK_INTERNAL_URL=http://127.0.0.1:8080
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio-local
MINIO_ROOT_PASSWORD=change-me-local-only
OBJECT_STORAGE_BUCKET=dispensa-media
OBJECT_STORAGE_EXPIRY_DAYS=30

# OIDC: public issuer is the URL encoded in JWTs; discovery/JWKS use the local Keycloak HTTP endpoint
# so the API never needs to perform TLS validation against the local nginx certificate.
# In docker compose questi valori sono derivati da LAN_HOST (issuer = https://${LAN_HOST}:8443/realms/dispensa,
# identico a KC_HOSTNAME di Keycloak); servono solo se avvii i servizi fuori da compose.
OIDC_ISSUER=https://192.168.1.24:8443/realms/dispensa
OIDC_AUDIENCE=account
OIDC_DISCOVERY_URL=http://127.0.0.1:8080/realms/dispensa/.well-known/openid-configuration
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/dispensa/protocol/openid-connect/certs

# Web is same-origin behind nginx.
VITE_API_BASE_URL=/api/v1
VITE_OIDC_ISSUER=/realms/dispensa
VITE_OIDC_CLIENT_ID=dispensa-app

# worker-integrations: separate container that talks to third-party product databases so a
# slow/unreachable third party can never affect the api container.
WORKER_INTEGRATIONS_PORT=3100
# Base URL the api uses to reach worker-integrations over the internal Docker network.
BARCODE_WORKER_URL=http://worker-integrations:3100
# Give up on the worker call after this long and fall back to manual entry.
BARCODE_WORKER_TIMEOUT_MS=3000
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_TIMEOUT_MS=4000

# --- off-lookup (microservizio cache barcode Open Food Facts) ---
OFF_LOOKUP_PORT=3200
# URL del MongoDB locale con il dump OFF. Lasciare vuoto per modalità API-only
# (il servizio funziona completamente senza MongoDB, ogni lookup va all'API remota).
# Per attivare la cache locale:
#   1. Avviare mongo-off-cache: docker compose --profile off-cache up -d mongo-off-cache
#   2. Importare il dump:       mongorestore --host 127.0.0.1:27017 --db off --collection products openfoodfacts-mongodbdump
#   3. Impostare questa variabile e riavviare off-lookup
OFF_LOOKUP_MONGO_URL=
OFF_LOOKUP_API_BASE_URL=https://world.openfoodfacts.org
# 0 = every barcode found locally is eligible; do not use OFF completeness as a lookup gate.
OFF_LOOKUP_MIN_COMPLETENESS=0
POSTGRES_APP_PASSWORD=change-me-app-local-only
POSTGRES_WORKER_PASSWORD=change-me-worker-local-only

# --- Observability (docs/OBSERVABILITY-DEBUGGING.md) ---
# debug | info | warn | error
LOG_LEVEL=info
# Empty = spans disabled. With `--profile observability-full` use the collector:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Requests slower than this (ms) are logged as warnings; queries slower than OBS_SLOW_QUERY_MS likewise.
OBS_SLOW_REQUEST_MS=2000
OBS_SLOW_QUERY_MS=500