APP_ENV=family-local
APP_VERSION=0.1.0-local
API_PORT=3000
POSTGRES_DB=dispensa
POSTGRES_USER=dispensa
POSTGRES_PASSWORD=change-me-local-only
REDIS_PORT=6379
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-only
KEYCLOAK_INTERNAL_URL=http://127.0.0.1:8080
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio-local
MINIO_ROOT_PASSWORD=change-me-local-only
OBJECT_STORAGE_BUCKET=dispensa-media
OBJECT_STORAGE_EXPIRY_DAYS=30

# OIDC: public issuer is the URL encoded in JWTs; discovery/JWKS use the local Keycloak HTTP endpoint
# so the API never needs to perform TLS validation against the local nginx certificate.
OIDC_ISSUER=https://192.168.1.24:8443/realms/dispensa
OIDC_AUDIENCE=account
OIDC_DISCOVERY_URL=https://192.168.1.24:8443/realms/dispensa/.well-known/openid-configuration
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/dispensa/protocol/openid-connect/certs

# Web is same-origin behind nginx.
VITE_API_BASE_URL=/api/v1
VITE_OIDC_ISSUER=/realms/dispensa
VITE_OIDC_CLIENT_ID=dispensa-app

# worker-integrations: separate container that talks to third-party product databases so a
# slow/unreachable third party can never affect the api container.
WORKER_INTEGRATIONS_PORT=3100
# Base URL the api uses to reach worker-integrations over the internal Docker network.
BARCODE_WORKER_URL=http://worker-integrations:3100
# Give up on the worker call after this long and fall back to manual entry.
BARCODE_WORKER_TIMEOUT_MS=3000
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_TIMEOUT_MS=4000