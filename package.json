{
  "name": "gestione-dispensa",
  "version": "0.1.0",
  "private": true,
  "description": "Family-first local pantry platform",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "validate:structure": "node tools/validate-structure.mjs",
    "build:services": "npm run build --workspaces --if-present",
    "typecheck:services": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  }
}
