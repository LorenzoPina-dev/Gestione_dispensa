    "services/identity",
    "services/inventory",
    "services/media",
    "services/notifications",
    "services/nutrition",
    "services/off-lookup",
    "services/offers",
    "services/products",
    "services/recipes",
    "services/scheduler",
    "services/search",
    "services/shopping",
    "services/stores",
    "services/users",
    "services/vision",
    "services/web",
    "services/worker-core",
    "services/worker-integrations"
  ],
  "engines": {
    "node": ">=22"
  }
}
