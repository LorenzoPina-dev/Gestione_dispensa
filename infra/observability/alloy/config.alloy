// Ships the stdout of every container of this compose project to Loki.
// Services and nginx write one JSON object per line (ts, level, service, event, requestId, traceId, ...).
//
// Cardinality policy (ADR-0002): only `service` and `level` become Loki labels.
// traceId / requestId are attached as structured metadata, so they are searchable
// (`{service="gateway"} | traceId="..."`) without creating one stream per request.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // Only this project's containers.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "gestione-dispensa"
    action        = "keep"
  }

  // Never ship our own log pipeline's output back into itself.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "alloy|loki"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.json.receiver]
}

loki.process "json" {
  // Non-JSON lines (Keycloak, Postgres, Redis) pass through untouched, without a level label.
  stage.json {
    expressions = {
      level     = "level",
      traceId   = "traceId",
      requestId = "requestId",
    }
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  stage.structured_metadata {
    values = {
      traceId   = "",
      requestId = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
